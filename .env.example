# Hugging Face
HF_TOKEN=your_hugging_face_token_here
HF_USERNAME=your_hf_username

# Kaggle
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_token

# GitHub
GITHUB_TOKEN=your_github_token_here

# NVIDIA NIM (Kimi K3)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=moonshotai/kimi-k3

# Kie.ai (Z-Image)
KIE_API_KEY=your_kie_ai_key_here
KIE_IMAGE_MODEL=z-image

# Firebase Config
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id
